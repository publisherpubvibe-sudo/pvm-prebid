NODE_ENV=production
PORT=4000

# MongoDB connection
MONGO_URI=mongodb://mongo:27017/pubvibe

# JWT secrets – change in production!
JWT_SECRET=CHANGE_THIS_JWT_SECRET_32CHARS_MIN
JWT_REFRESH_SECRET=CHANGE_THIS_REFRESH_SECRET_32CHARS

# Prebid Server internal URL
PREBID_SERVER_URL=http://prebid-server:8000

# PubVibe SSP endpoints
PUBVIBE_USEAST=https://rtb-useast.trackifyy.com/rtb
PUBVIBE_USWEST=https://rtb-uswest.trackifyy.com/rtb
PUBVIBE_EU=https://rtb-eu.trackifyy.com/rtb
PUBVIBE_APAC=https://rtb-apac.trackifyy.com/rtb

# Log level
LOG_LEVEL=info
